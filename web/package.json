{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "prebuild": "node -e \"const fs=require('fs'),p='../webdist/assets';if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true})\"",
    "postbuild": "node -e \"const s=require('fs').readFileSync('../webdist/index.html','utf8');if(/<script(?![^>]*\\\\bsrc=)|data:text\\/javascript/.test(s))throw Error('built index violates script-src self CSP')\"",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "pinia": "^4.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^24.1.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.5"
  }
}
