# /etc/herdrem/herdrem.env — copy this file and fill in real values.
# Loaded by herdrem.service via EnvironmentFile=.

# Relay listen port (default 8766)
# HERDREM_PORT=8766

# Shared-secret token for relay auth.
# REQUIRED for any non-loopback exposure (tunnels, LAN, public).
# Generate with: openssl rand -hex 16
HERDREM_TOKEN=

# Path to herdr binary (auto-detected from PATH if unset)
# HERDR_BIN=/usr/local/bin/herdr

# Comma-separated SSH remotes (optional, requires passwordless SSH keys)
# HERDR_REMOTES=user@server1,user@server2

# Pane kinds to broadcast: agent, shell, or both (comma-separated)
# HERDREM_KINDS=agent,shell

# Data directory for todo/prefs/poller state
# HERDREM_DATA_DIR=/var/lib/herdrem

# Cross-origin WebSocket allowlist (comma-separated host patterns)
# Empty = same-origin only (recommended unless using a separate UI host)
# HERDR_ALLOWED_ORIGINS=localhost:8765
